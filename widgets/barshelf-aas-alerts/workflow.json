{
  "schemaVersion": 1,
  "kind": "workflow",
  "_comment": "Notifies on low quota and recovery. Uses successful percentage readings and skips accounts that report no percentage. A fetch error blocks recovery and leaves the low alert armed state unchanged unless a healthy reading crosses the low threshold.",
  "sources": {
    "usage": {
      "use": "exec",
      "with": {
        "command": [
          "aas",
          "usage",
          "--json"
        ]
      }
    }
  },
  "transforms": {
    "errored": {
      "use": "filter",
      "from": "sources.usage.accounts",
      "with": {
        "field": "error",
        "notEquals": null
      }
    },
    "successful": {
      "use": "filter",
      "from": "sources.usage.accounts",
      "with": {
        "field": "error",
        "equals": null
      }
    },
    "metered": {
      "use": "filter",
      "from": "transforms.successful",
      "with": {
        "field": "remainingPct",
        "notEquals": null
      }
    },
    "ordered": {
      "use": "sort",
      "from": "transforms.metered",
      "with": {
        "by": "remainingPct"
      }
    },
    "worst": {
      "use": "assign",
      "from": "number(transforms.ordered.0.remainingPct)"
    },
    "complete": {
      "use": "assign",
      "from": "eq(count(transforms.errored), 0)"
    }
  },
  "alerts": {
    "low": {
      "when": "${if(eq(transforms.worst, null), null, if(lte(transforms.worst, settings.lowPct), true, if(transforms.complete, false, null)))}",
      "title": "An agent account is down to ${string(round(transforms.worst))}% left",
      "body": "Open BarShelf to see which account, or switch with aas.",
      "cooldownSec": 3600
    },
    "reset": {
      "when": "${if(or(eq(transforms.worst, null), not(transforms.complete)), null, gte(transforms.worst, settings.resetPct))}",
      "title": "Agent limits look reset",
      "body": "Every account reporting a percentage has ${string(round(transforms.worst))}% or more left.",
      "cooldownSec": 3600
    }
  },
  "view": {
    "type": "vstack",
    "spacing": 6,
    "children": [
      {
        "type": "hstack",
        "spacing": 6,
        "children": [
          {
            "type": "image",
            "source": {
              "kind": "sfSymbol",
              "name": "bell.badge"
            },
            "size": 14,
            "tint": "${if(lte(coalesce(transforms.worst, 100), settings.lowPct), 'warning', 'secondary')}"
          },
          {
            "type": "text",
            "text": "Lowest left",
            "role": "caption",
            "foreground": "secondary",
            "lineLimit": 1
          }
        ]
      },
      {
        "type": "text",
        "text": "${if(eq(transforms.worst, null), '—', concat(string(round(transforms.worst)), '%'))}",
        "size": 34,
        "role": "title",
        "monospacedDigit": true
      },
      {
        "type": "text",
        "text": "Alerts at ${string(settings.lowPct)}% left",
        "role": "caption",
        "foreground": "secondary",
        "lineLimit": 1
      }
    ]
  },
  "status": {
    "label": "${if(eq(transforms.worst, null), '', concat(string(round(transforms.worst)), '%'))}",
    "tooltip": "Lowest left across aas accounts"
  }
}
